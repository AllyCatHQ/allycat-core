{
  "name": "allycat",
  "version": "1.5.0",
  "description": "Accessibility tool for source files — scans JSX, Vue, Angular, and HTML without a running server. Exact line numbers, watch mode, CI gates, AI fix prompts. WCAG 2.1 AA, WCAG 2.2 AA, and WCAG AAA (automated rules) with optional RTL support.",
  "main": "src/index.js",
  "bin": {
    "allycat": "src/index.js"
  },
  "scripts": {
    "test": "node tests/e2e/thresholds.test.js && node tests/e2e/concurrency.test.js && node tests/e2e/exclude.test.js && node tests/e2e/standards.test.js && node tests/e2e/never-scan.test.js && node tests/e2e/config-loader.test.js",
    "test:full": "npm test && node tests/e2e/css-delivery.test.js",
    "dev": "node ./src/index.js",
    "lint": "eslint src/"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "wcag2",
    "axe-core",
    "cli",
    "linter",
    "scanner",
    "static-analysis",
    "testing",
    "audit",
    "compliance",
    "rtl",
    "jsx",
    "vue",
    "angular",
    "html",
    "section508",
    "ada",
    "allycat"
  ],
  "author": "Dotan Siman Tov",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AllyCatHQ/allycat-core.git"
  },
  "homepage": "https://github.com/AllyCatHQ/allycat-core#readme",
  "bugs": {
    "url": "https://github.com/AllyCatHQ/allycat-core/issues"
  },
  "files": [
    "src/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@clack/prompts": "^1.0.0",
    "@vue/compiler-dom": "^3.5.29",
    "axe-core": "^4.11.1",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "glob": "^13.0.2",
    "jsdom": "^28.0.0",
    "p-limit": "^7.3.0",
    "playwright": "^1.58.2",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "eslint": "^10.0.3",
    "eslint-plugin-n": "^17.24.0"
  }
}
